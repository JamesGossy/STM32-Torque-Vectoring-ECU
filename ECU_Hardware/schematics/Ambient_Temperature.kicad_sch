	(text "Place TH1 near ventilated PCB edge, away from buck, LDO and MCU.\nThis measures local PCB/enclosure temperature; ambient accuracy\ndepends on thermal placement. No external sensor power from USB."
		(exclude_from_sim no)
		(at 40.64 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4bacffdb-b8dd-446f-8d2e-316a37792585")
	)
	(text "AMBIENT TEMPERATURE - 10k NTC / ADC"
		(exclude_from_sim no)
		(at 83.312 44.704 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
		(uuid "c7a35eaf-0ed5-4827-b70e-582b65a3615c")
	)
	(text "TEMP_SENSE -> PA0 / ADC1_IN1 (analog, no pull-up/down).\nUse long ADC acquisition time (e.g. 247.5 cycles); average readings.\nAccount for VREF+ versus divider supply; use Murata R/T table.\nRntc = 39000 * Vout / (V3V3 - Vout). Detect open/short faults."
		(exclude_from_sim no)
		(at 40.64 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dc23031d-9353-4fda-925a-a0f08c02dea7")
	)
